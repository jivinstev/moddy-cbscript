#!/usr/bin/env bash
# PRE-PUSH: refuse a push whose commits ADD third-party code or text under a licence that is not on the allow-list
# (tools/licence-scan.py --range). This sees every commit about to leave the machine, including one that never met
# pre-commit (a cherry-pick, a commit from another clone). Each commit is judged on its own: something added and
# removed again later is still in the history. Pushing a branch here publishes it.
set -uo pipefail
remote="${1:-origin}"
top="$(git rev-parse --show-toplevel)" || exit 1
if [ ! -f "$top/tools/licence-scan.py" ]; then
    echo "pre-push: tools/licence-scan.py is missing, so nothing can be checked; refusing the push" >&2
    exit 1
fi
zero="$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')"
rc=0
while read -r _lref lsha _rref rsha; do
    [ -z "${lsha:-}" ] && continue
    [ "$lsha" = "$zero" ] && continue                          # deleting a ref adds nothing
    if [ "$rsha" = "$zero" ] || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
        revs=("$lsha" --not "--remotes=$remote")                # a new branch, or a remote tip we do not have
    else
        revs=("$rsha..$lsha")
    fi
    python3 "$top/tools/licence-scan.py" --repo "$top" --range -- "${revs[@]}" >&2 || rc=1
done
if [ "$rc" -ne 0 ]; then
    echo "pre-push: REFUSED. A commit above adds code under a licence off the allow-list (or the scan could not run)." >&2
    echo "pre-push: Fix that COMMIT (amend or rebase it out); a later commit that deletes it leaves it in the history." >&2
fi
exit "$rc"
