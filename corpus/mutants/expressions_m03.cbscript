# mutant of corpus/programs/expressions.cbscript: truncate before line 22
dir "."
desc "Scalar expressions"

$value = 21

reset
	a = 1
	b = 2
	c = a + b * 3 - 4 / 2 % 7
	c = (a + b) * (c - a)
	c = -a
	c = - (a + 3)
	c = a ^ 3
	c += 5
	c -= -5
	c *= a
	c /= 2
	c %= 3
	c++
	c--
	c = 0x1F + 0b101 - -7 + -0x10